# ==========================================
# Luxury Shop BD — Supabase Configuration
# ==========================================
# Get these keys from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys
#
# IMPORTANT:
# - ONLY use the `anon` (public) key in the frontend!
# - NEVER put your `service_role` key here!
# ==========================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

